# Flask
SECRET_KEY=changeme_generate_with_python_c_import_secrets_print_secrets_token_hex_32
JWT_SECRET_KEY=changeme_generate_with_python_c_import_secrets_print_secrets_token_hex_32

# Database
DATABASE_URL=postgresql://user:password@host:5432/dbname?sslmode=require
DB_POOL_SIZE=10
DB_POOL_RECYCLE=300
DB_MAX_OVERFLOW=20

# JWT
JWT_ACCESS_MINUTES=30
JWT_REFRESH_DAYS=30

# CORS (comma-separated origins)
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# Redis (for rate limiting in production)
REDIS_URL=redis://localhost:6379/0

# Security
FORCE_HTTPS=false
SESSION_COOKIE_SECURE=false
MAX_CONTENT_LENGTH_MB=5

# Logging
LOG_LEVEL=INFO

# Flask
FLASK_DEBUG=false
FLASK_ENV=production
